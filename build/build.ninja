build geyser_frontend: phony libgeyser_frontend.a

build gpm: phony D$:/Geyser/engine/bin/gpm.exe

build gpm.exe: phony D$:/Geyser/engine/bin/gpm.exe

build gy: phony D$:/Geyser/engine/bin/gy.exe

build gy.exe: phony D$:/Geyser/engine/bin/gy.exe

build gybuild: phony D$:/Geyser/engine/bin/gybuild.exe

build gybuild.exe: phony D$:/Geyser/engine/bin/gybuild.exe

build gydb: phony D$:/Geyser/engine/bin/gydb.exe

build gydb.exe: phony D$:/Geyser/engine/bin/gydb.exe

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/Geyser/build

build codegen: phony

# =============================================================================

#############################################
# Folder: D:/Geyser/build

build all: phony libgeyser_frontend.a D$:/Geyser/engine/bin/gy.exe D$:/Geyser/engine/bin/gpm.exe D$:/Geyser/engine/bin/gybuild.exe D$:/Geyser/engine/bin/gydb.exe

